// SkillNex - Prisma Database Schema
// PostgreSQL Database for Student Progress and Profiles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// 1. User Account Profile (linked to Clerk external ID)
// -------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  fullName      String?
  avatarUrl     String?
  selectedTrack String   @default("core-electronics")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Student progress relationships
  topicProgress   UserTopicProgress[]
  dsaProgress     UserDsaProgress[]
  problemProgress UserProblemProgress[]

  @@index([clerkId])
}

// -------------------------------------------------------------
// 2. Core Electronics Topic Progress
// -------------------------------------------------------------
model UserTopicProgress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String   // Stable curriculum ID: e.g. "c-intro-compilation", "analog-bjt-cb-config"
  stageId     String   // Stage identifier: "c-programming", "git-github", "analog-electronics", "digital-electronics"
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforce one progress entry per user per topic
  @@unique([userId, topicId])
  @@index([userId, stageId])
  @@index([topicId])
}

// -------------------------------------------------------------
// 3. DSA Question Progress
// -------------------------------------------------------------
model UserDsaProgress {
  id          String   @id @default(cuid())
  userId      String
  questionId  String   // Stable question ID: e.g. "dsa-arr-01", "dsa-str-03"
  categoryId  String   // Category identifier: "arrays", "strings", "linked-lists", etc.
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforce one progress entry per user per question
  @@unique([userId, questionId])
  @@index([userId, categoryId])
  @@index([questionId])
}

// -------------------------------------------------------------
// 4. Hardware & Verilog (HDLBits) Problem Progress
// -------------------------------------------------------------
enum ProblemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UserProblemProgress {
  id        String        @id @default(cuid())
  userId    String
  problemId String        // Stable problem ID: e.g. "hdl-step-one", "hdl-wire"
  status    ProblemStatus @default(NOT_STARTED)
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforce one status entry per user per problem
  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}
