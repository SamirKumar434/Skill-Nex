# SkillNex Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit .env or .env.local to version control.

# -------------------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# -------------------------------------------------------------
# Pooled connection string (used by Prisma Client in serverless runtime)
# Typically ends with -pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection string (used by Prisma CLI for migrations)
# Typically points to the direct endpoint without -pooler
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------
# Authentication (Clerk - Phase 2.2)
# Obtain these from your Clerk Dashboard: https://dashboard.clerk.com -> API Keys
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
